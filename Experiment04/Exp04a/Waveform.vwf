/*<simulation_settings>
<ftestbench_cmd>quartus_eda --gen_testbench --tool=modelsim_oem --format=vhdl --write_settings_files=off Exp04a -c Exp04a --vector_source="D:/Softwares_Pro/Quartus/Project/Experiment04/Exp04a/Waveform.vwf" --testbench_file="D:/Softwares_Pro/Quartus/Project/Experiment04/Exp04a/simulation/qsim/Waveform.vwf.vht"</ftestbench_cmd>
<ttestbench_cmd>quartus_eda --gen_testbench --tool=modelsim_oem --format=vhdl --write_settings_files=off Exp04a -c Exp04a --vector_source="D:/Softwares_Pro/Quartus/Project/Experiment04/Exp04a/Waveform.vwf" --testbench_file="D:/Softwares_Pro/Quartus/Project/Experiment04/Exp04a/simulation/qsim/Waveform.vwf.vht"</ttestbench_cmd>
<fnetlist_cmd>quartus_eda --write_settings_files=off --simulation --functional=on --flatten_buses=off --tool=modelsim_oem --format=vhdl --output_directory="D:/Softwares_Pro/Quartus/Project/Experiment04/Exp04a/simulation/qsim/" Exp04a -c Exp04a</fnetlist_cmd>
<tnetlist_cmd>quartus_eda --write_settings_files=off --simulation --functional=off --flatten_buses=off --timescale=1ps --tool=modelsim_oem --format=vhdl --output_directory="D:/Softwares_Pro/Quartus/Project/Experiment04/Exp04a/simulation/qsim/" Exp04a -c Exp04a</tnetlist_cmd>
<modelsim_script>onerror {exit -code 1}
vlib work
vcom -work work Exp04a.vho
vcom -work work Waveform.vwf.vht
vsim -suppress 12110 -voptargs="+acc" -c -t 1ps -L cycloneive -L altera -L altera_mf -L 220model -L sgate -L altera_lnsim work.MUX41_vhd_vec_tst
vcd file -direction Exp04a.msim.vcd
vcd add -internal MUX41_vhd_vec_tst/*
vcd add -internal MUX41_vhd_vec_tst/i1/*
proc simTimestamp {} {
    echo "Simulation time: $::now ps"
    if { [string equal running [runStatus]] } {
        after 2500 simTimestamp
    }
}
after 2500 simTimestamp
run -all
quit -f


</modelsim_script>
<modelsim_script_timing>onerror {exit -code 1}
vlib work
vcom -work work Exp04a.vho
vcom -work work Waveform.vwf.vht
vsim -suppress 12110 -voptargs="+acc" -c -t 1ps -sdfmax MUX41_vhd_vec_tst/i1=Exp04a_vhd.sdo -L cycloneive -L altera -L altera_mf -L 220model -L sgate -L altera_lnsim work.MUX41_vhd_vec_tst
vcd file -direction Exp04a.msim.vcd
vcd add -internal MUX41_vhd_vec_tst/*
vcd add -internal MUX41_vhd_vec_tst/i1/*
proc simTimestamp {} {
    echo "Simulation time: $::now ps"
    if { [string equal running [runStatus]] } {
        after 2500 simTimestamp
    }
}
after 2500 simTimestamp
run -all
quit -f


</modelsim_script_timing>
<hdl_lang>vhdl</hdl_lang>
</simulation_settings>*/
